{
  "name": "sfo-deploy",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts"
  },
  "lock": {
    "path": "./deno.lock"
  },
  "tasks": {
    "bundle:remote-runtime": "deno bundle --frozen --no-npm --minify src/remote_runtime/config_updater.ts -o src/remote_runtime/config_updater.bundle.js",
    "check": "deno check --frozen src/mod.ts src/main.ts src/cli.ts src/remote_runtime/config_updater.ts",
    "lint": "deno lint src tests examples/eleph-server-multipass/src",
    "fmt": "deno fmt --check src tests examples/eleph-server-multipass/src deno.json examples/eleph-server-multipass/deno.json",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run tests"
  },
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "exclude": ["src/remote_runtime/config_updater.bundle.js"],
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "fmt": {
    "exclude": ["src/remote_runtime/config_updater.bundle.js"],
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  }
}
